# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.

# Free access key from https://web3forms.com (makes the contact form send email).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Your live address, for example https://www.yourdomain.com
# Used for meta tags, the sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=
